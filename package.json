{
  "name": "@terrytsai/lodot",
  "version": "0.1.0",
  "description": "Utilities for simplifying and standardizing evals across projects.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerryTsai/lodot.git"
  },
  "homepage": "https://github.com/TerryTsai/lodot#readme",
  "bugs": {
    "url": "https://github.com/TerryTsai/lodot/issues"
  },
  "keywords": [
    "typescript",
    "utilities",
    "evals",
    "microsandbox",
    "sandbox",
    "testing"
  ],
  "author": "Terry Tsai",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@openai/codex-sdk": "^0.163.0",
    "@sentry/node": "^10.76.2",
    "@types/node": "^22.20.5",
    "deepeval": "^0.9.22",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "microsandbox": "^0.7.8"
  },
  "peerDependencies": {
    "@openai/codex-sdk": "^0.163.0",
    "deepeval": "^0.9.22",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    }
  }
}
